DATABASE_URL=postgresql://smart:smart@localhost:5432/smart_locker_test
AUTH_SECRET=replace-with-32-or-more-characters
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=re_replace_me
PRIVACY_CONTACT_EMAIL=privacy@example.com
LOCK_PROVIDER=mock
RELOCK_SECONDS=1
SHARING_ENABLED=true
LOCK_COMMANDS_ENABLED=true
CRON_SECRET=e2e-cron-secret-at-least-16
E2E=1

# TTLock quota guard (set TTLOCK_MONTHLY_QUOTA to the developer console limit; 0 disables)
TTLOCK_MONTHLY_QUOTA=0
TTLOCK_QUOTA_SOFT_LIMIT_PERCENT=80
LOCK_STATE_CACHE_SECONDS=30
